<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import com.disaster.alert.util.ParticleNetworkCanvas?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.disaster.alert.controller.RegisterController"
           styleClass="login-root"
           stylesheets="@/css/login.css"
           maxWidth="Infinity"
           maxHeight="Infinity">

    <!-- Same particle animation as login -->
    <ParticleNetworkCanvas/>

    <!-- Scrollable centered content -->
    <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background: transparent; -fx-background-color: transparent;
                       -fx-border-color: transparent;">
        <VBox alignment="CENTER" spacing="0"
              style="-fx-min-height: 700px;"
              fillWidth="true">

            <!-- Glass card -->
            <VBox styleClass="glass-card"
                  alignment="CENTER"
                  spacing="16">
                <padding>
                    <Insets top="36" right="40" bottom="36" left="40"/>
                </padding>

                <!-- Logo badge -->
                <VBox styleClass="login-logo-box" alignment="CENTER" spacing="4">
                    <Label text="&#127757;" style="-fx-font-size: 32px;"/>
                    <Label text="NADAS" styleClass="login-brand"/>
                </VBox>

                <!-- Title -->
                <VBox spacing="6" alignment="CENTER">
                    <Label text="Create New Account" styleClass="login-title">
                        <font><Font name="System Bold" size="24"/></font>
                    </Label>
                    <Label text="New user signup" styleClass="login-subtitle"/>
                </VBox>

                <Separator styleClass="login-divider" maxWidth="Infinity"/>

                <!-- Name field -->
                <VBox spacing="7" maxWidth="Infinity">
                    <Label text="Full Name" styleClass="login-field-label">
                        <font><Font name="System Bold" size="12"/></font>
                    </Label>
                    <TextField fx:id="nameField"
                               promptText="Enter your full name"
                               styleClass="login-field"
                               maxWidth="Infinity">
                        <font><Font size="13"/></font>
                    </TextField>
                </VBox>

                <!-- Email field -->
                <VBox spacing="7" maxWidth="Infinity">
                    <Label text="Email Address" styleClass="login-field-label">
                        <font><Font name="System Bold" size="12"/></font>
                    </Label>
                    <TextField fx:id="emailField"
                               promptText="Enter your email"
                               styleClass="login-field"
                               maxWidth="Infinity">
                        <font><Font size="13"/></font>
                    </TextField>
                </VBox>

                <!-- Password field -->
                <VBox spacing="7" maxWidth="Infinity">
                    <Label text="Password" styleClass="login-field-label">
                        <font><Font name="System Bold" size="12"/></font>
                    </Label>
                    <PasswordField fx:id="passwordField"
                                   promptText="Enter your password"
                                   styleClass="login-field"
                                   maxWidth="Infinity">
                        <font><Font size="13"/></font>
                    </PasswordField>
                </VBox>

                <!-- City -->
                <VBox spacing="7" maxWidth="Infinity">
                    <Label text="City" styleClass="login-field-label">
                        <font><Font name="System Bold" size="12"/></font>
                    </Label>
                    <ComboBox fx:id="cityComboBox"
                              maxWidth="Infinity"
                              styleClass="register-combo"/>
                </VBox>

                <!-- Alert Types -->
                <VBox spacing="8" maxWidth="Infinity">
                    <Label text="Alert Types" styleClass="login-field-label">
                        <font><Font name="System Bold" size="12"/></font>
                    </Label>
                    <HBox spacing="24">
                        <CheckBox fx:id="weatherCheckBox"    text="Weather"
                                  styleClass="register-checkbox"/>
                        <CheckBox fx:id="earthquakeCheckBox" text="Earthquake"
                                  styleClass="register-checkbox"/>
                    </HBox>
                    <HBox spacing="24">
                        <CheckBox fx:id="fireCheckBox"  text="Fire"
                                  styleClass="register-checkbox"/>
                        <CheckBox fx:id="floodCheckBox" text="Flood"
                                  styleClass="register-checkbox"/>
                    </HBox>
                </VBox>

                <!-- Error / Success labels -->
                <Label fx:id="errorLabel" text=""
                       styleClass="login-error"
                       visible="false" wrapText="true" maxWidth="Infinity">
                    <font><Font size="12"/></font>
                </Label>
                <Label fx:id="successLabel" text=""
                       styleClass="register-success"
                       visible="false" wrapText="true" maxWidth="Infinity">
                    <font><Font size="12"/></font>
                </Label>

                <!-- Create Account button -->
                <Button fx:id="createAccountButton"
                        text="Create Account"
                        onAction="#handleCreateAccount"
                        styleClass="login-btn"
                        maxWidth="Infinity">
                    <font><Font name="System Bold" size="14"/></font>
                </Button>

                <!-- Login link -->
                <HBox alignment="CENTER" spacing="5">
                    <Label text="Already have an account?" styleClass="login-small-text"/>
                    <Hyperlink fx:id="loginLink"
                               text="Login"
                               onAction="#handleBackToLogin"
                               styleClass="login-register-link">
                        <font><Font name="System Bold" size="12"/></font>
                    </Hyperlink>
                </HBox>

            </VBox>

            <!-- Bottom brand tag -->
            <Label text="Natural &amp; Artificial Disaster Alert System  •  v1.0"
                   style="-fx-text-fill: rgba(100,180,255,0.3); -fx-font-size: 10px;"
                   alignment="CENTER">
                <VBox.margin><Insets top="16"/></VBox.margin>
            </Label>

        </VBox>
    </ScrollPane>

</StackPane>
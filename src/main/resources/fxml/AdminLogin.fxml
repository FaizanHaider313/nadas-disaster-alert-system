<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import com.disaster.alert.util.ParticleNetworkCanvas?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.disaster.alert.controller.AdminLoginController"
           stylesheets="@/css/login.css"
           styleClass="login-root"
           maxWidth="Infinity" maxHeight="Infinity">

    <ParticleNetworkCanvas/>

    <VBox alignment="CENTER" spacing="0">

        <!-- Glass card -->
        <VBox styleClass="glass-card" alignment="CENTER" spacing="20">
            <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

            <!-- Logo -->
            <VBox styleClass="login-logo-box" alignment="CENTER" spacing="4">
                <Label text="&#128274;"
                       style="-fx-font-size: 32px;
                              -fx-effect: dropshadow(gaussian,rgba(100,200,255,0.8),14,0,0,0);"/>
                <Label text="ADMIN" styleClass="login-brand"/>
            </VBox>

            <!-- Title -->
            <VBox spacing="6" alignment="CENTER">
                <Label text="Admin Access" styleClass="login-title">
                    <font><Font name="System Bold" size="24"/></font>
                </Label>
                <Label text="Restricted to system administrators only"
                       styleClass="login-subtitle"/>
            </VBox>

            <Separator styleClass="login-divider" maxWidth="Infinity"/>

            <!-- Email -->
            <VBox spacing="7" maxWidth="Infinity">
                <Label text="Admin Email" styleClass="login-field-label">
                    <font><Font name="System Bold" size="12"/></font>
                </Label>
                <TextField fx:id="emailField"
                           promptText="Enter admin email"
                           styleClass="login-field"
                           maxWidth="Infinity">
                    <font><Font size="13"/></font>
                </TextField>
            </VBox>

            <!-- Password -->
            <VBox spacing="7" maxWidth="Infinity">
                <Label text="Password" styleClass="login-field-label">
                    <font><Font name="System Bold" size="12"/></font>
                </Label>
                <PasswordField fx:id="passwordField"
                               promptText="Enter admin password"
                               styleClass="login-field"
                               maxWidth="Infinity">
                    <font><Font size="13"/></font>
                </PasswordField>
            </VBox>

            <!-- Error label -->
            <Label fx:id="errorLabel" text=""
                   styleClass="login-error"
                   wrapText="true" visible="false"
                   maxWidth="Infinity">
                <font><Font size="12"/></font>
            </Label>

            <!-- Login button -->
            <Button fx:id="loginButton"
                    text="&#128275;  Login as Admin"
                    onAction="#handleAdminLogin"
                    styleClass="login-btn"
                    maxWidth="Infinity">
                <font><Font name="System Bold" size="14"/></font>
            </Button>

            <!-- Warning -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-background-color: rgba(255,200,50,0.08);
                         -fx-background-radius: 10px;
                         -fx-border-color: rgba(236,201,75,0.25);
                         -fx-border-radius: 10px;
                         -fx-border-width: 1px;
                         -fx-padding: 10px 14px;">
                <Label text="&#9888;"
                       style="-fx-font-size: 14px;
                              -fx-text-fill: rgba(236,201,75,0.8);"/>
                <Label text="Unauthorized access attempts are logged."
                       style="-fx-text-fill: rgba(236,201,75,0.65);
                              -fx-font-size: 11px;"
                       wrapText="true"/>
            </HBox>

            <!-- Back link -->
            <HBox alignment="CENTER" spacing="5">
                <Label text="Not an admin?" styleClass="login-small-text"/>
                <Hyperlink text="Back to Dashboard"
                           onAction="#handleBack"
                           styleClass="login-register-link">
                    <font><Font name="System Bold" size="12"/></font>
                </Hyperlink>
            </HBox>

        </VBox>

        <!-- Bottom brand -->
        <Label text="Natural &amp; Artificial Disaster Alert System  •  v2.0"
               style="-fx-text-fill: rgba(100,180,255,0.3); -fx-font-size: 10px;"
               alignment="CENTER">
            <VBox.margin><Insets top="16"/></VBox.margin>
        </Label>

    </VBox>
</StackPane>